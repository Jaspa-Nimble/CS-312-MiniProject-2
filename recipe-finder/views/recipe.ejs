<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Dynamically display the meal title in the browser tab -->
    <title><%= meal.strMeal %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">

    <div class="container my-5">
        <!-- Back button to return to search page -->
        <a href="/" class="btn btn-secondary mb-4">&larr; Back to Search</a>
        
        <div class="row">
            
            <!-- MAIN API: Meal Details -->
            <div class="col-md-8 mb-4">
                <div class="card p-4 shadow-sm">
                    <img src="<%= meal.strMealThumb %>" class="img-fluid rounded mb-3" alt="<%= meal.strMeal %>">
                    <h2><%= meal.strMeal %></h2>
                    <p class="badge bg-primary fs-6 d-inline-block">
                        Category: <%= meal.strCategory %> | Area: <%= meal.strArea %>
                    </p>
                    
                    <h4 class="mt-3">Instructions:</h4>
                    <p><%= meal.strInstructions %></p>
                </div>
            </div>

            <!-- SECOND API (Bonus): Drink Pairing -->
            <div class="col-md-4 mb-4">
                <div class="card p-4 shadow-sm border-warning">
                    <span class="badge bg-warning text-dark mb-2">Recommended Drink</span>
                    <h3><%= drink.strDrink %></h3>
                    <img src="<%= drink.strDrinkThumb %>" class="img-fluid rounded my-3" alt="<%= drink.strDrink %>">
                    
                    <p><strong>Type:</strong> <%= drink.strCategory %> (<%= drink.strAlcoholic %>)</p>
                    
                    <h5>Drink Instructions:</h5>
                    <p><%= drink.strInstructions %></p>
                </div>
            </div>

        </div>
    </div>

</body>
</html>